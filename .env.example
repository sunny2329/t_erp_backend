NODE_ENV=development
PORT=4000
API_PREFIX=/dispatch_api/v1

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=t_erp
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Auth
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d
COOKIE_NAME=token

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend origin — used to build the public rate-confirmation link emailed
# to carriers (points at the React app, not this API).
FRONTEND_URL=http://localhost:5173

# SMTP (rate-con / customer-confirmation emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
